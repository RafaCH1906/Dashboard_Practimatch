# ============================================
# PRACTIMATCH WAITLIST API - ENVIRONMENT VARS
# ============================================
# Copia este archivo a .env y ajusta los valores

# ============================================
# DATABASE
# ============================================
# Local development (PostgreSQL)
DATABASE_URL=postgresql://practi_user:tu_password@localhost:5432/practi_waitlist

# Production (ejemplo con Supabase)
# DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ============================================
# APPLICATION
# ============================================
ENVIRONMENT=development
APP_NAME=PractiMatch Waitlist API
VERSION=1.0.0

# ============================================
# JWT AUTHENTICATION
# ============================================
# ⚠️ IMPORTANTE: Genera una clave segura con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================
# ADMIN USER (para create_admin.py)
# ============================================
ADMIN_EMAIL=admin@practimatch.com
ADMIN_PASSWORD=change-this-secure-password-123

# ============================================
# CORS (Frontend URLs)
# ============================================
# Development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Production (separar por comas)
# ALLOWED_ORIGINS=https://tuapp.com,https://www.tuapp.com,https://tuapp.vercel.app

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=10

# ============================================
# LOGGING
# ============================================
# Opciones: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
